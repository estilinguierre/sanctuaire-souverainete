<UserControl x:Class="ParasolidConverterPro.Views.FileSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ParasolidConverterPro.Models"
             xmlns:conv="clr-namespace:ParasolidConverterPro.Converters">

    <UserControl.Resources>
        <conv:FileStatusToColorConverter x:Key="FileStatusToColor"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBg}" Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: File list ──────────────────────────────────────────── -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Sélection des fichiers" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="Ajoutez des fichiers Parasolid (.x_t, .x_b) ou des dossiers complets."
                           Style="{StaticResource TextSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Drop zone + file list -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <!-- Empty state / drop zone -->
                <Grid>
                    <Border Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                            CornerRadius="8" Margin="24" Padding="40"
                            Background="Transparent">
                        <Border.BorderDashStyle>
                            <x:Static Member="DashStyles.Dash"/>
                        </Border.BorderDashStyle>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="Glissez vos fichiers ici" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text=".x_t · .x_b · dossiers"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- File list -->
                    <ListBox ItemsSource="{Binding Files}"
                             Background="Transparent" BorderThickness="0"
                             Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ParasolidFile}">
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status stripe -->
                                    <Rectangle Grid.Column="0" Width="4" CornerRadius="2"
                                               Fill="{Binding Status, Converter={StaticResource FileStatusToColor}}"
                                               Margin="0,4"/>

                                    <!-- File info -->
                                    <StackPanel Grid.Column="1" Margin="10,4">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontSize="13"/>
                                        <TextBlock Foreground="{StaticResource BrushTextMuted}" FontSize="11"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding FileSizeDisplay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding FileType}"/>
                                            <Run Text="{Binding BodyCount, StringFormat=' · {0} corps', FallbackValue=''}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Status badge -->
                                    <Border Grid.Column="2" CornerRadius="4" Padding="6,2" Margin="4,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.2"
                                                Color="{Binding Status, Converter={StaticResource FileStatusToColor}}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource FileStatusToColor}}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Assembly badge -->
                                    <Border Grid.Column="3" CornerRadius="4" Padding="5,2" Margin="2,0"
                                            Background="#1A0078D4" VerticalAlignment="Center"
                                            Visibility="{Binding IsAssembly, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ASM" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccent}"/>
                                    </Border>

                                    <!-- Remove button -->
                                    <Button Grid.Column="4" Content="✕" Width="24" Height="24"
                                            FontSize="11" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource BrushTextMuted}"
                                            Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1AF44336"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="+ Fichiers" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding AddFilesCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Dossier" Style="{StaticResource ButtonSecondary}"
                        Command="{Binding AddFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Vider" Style="{StaticResource ButtonDanger}"
                        Command="{Binding ClearFilesCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ── Right: Summary + Analyse ────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stats card -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,32,0,12">
                <StackPanel>
                    <TextBlock Text="Résumé" Style="{StaticResource TextLabel}"/>
                    <Separator/>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fichiers sélectionnés"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding FileCount}"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   FontWeight="Bold" FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Analyse button -->
            <Button Grid.Row="1" Content="Analyser les fichiers →"
                    Style="{StaticResource ButtonPrimary}"
                    Command="{Binding AnalyzeFilesCommand}"
                    HorizontalAlignment="Stretch" Padding="0,14"/>

            <!-- Help card -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Formats supportés" Style="{StaticResource TextLabel}"/>
                    <Separator/>
                    <TextBlock Text=".x_t — Parasolid texte" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,4"/>
                    <TextBlock Text=".x_b — Parasolid binaire" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,4"/>
                    <Separator Margin="0,8"/>
                    <TextBlock Text="L'analyse détecte automatiquement :" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,4"/>
                    <TextBlock Text="• Version du schéma Parasolid" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="8,2"/>
                    <TextBlock Text="• Nombre de corps solides" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="8,2"/>
                    <TextBlock Text="• Pièce unique ou assemblage" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="8,2"/>
                    <TextBlock Text="• Surfaces / arêtes" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}" Margin="8,2"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
