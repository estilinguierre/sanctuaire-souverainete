<Window x:Class="ParasolidConverterPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ParasolidConverterPro.Views"
        Title="Parasolid Converter Pro"
        Width="1280" Height="800"
        MinWidth="920" MinHeight="620"
        Background="{StaticResource BrushBg}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6"
                            Background="{StaticResource BrushSWBlue}" Margin="0,0,10,0">
                        <TextBlock Text="P" FontSize="18" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Parasolid Converter Pro" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsSimulatedMode, Converter={StaticResource BoolToVisibility}}"
                        Background="#1AFFC107" BorderBrush="{StaticResource BrushWarning}"
                        BorderThickness="1" CornerRadius="4" Padding="10,3">
                    <TextBlock Text="MODE SIMULATION — Phase 1" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushWarning}"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{StaticResource BrushSuccess}"/>
                    <TextBlock Text="{Binding ServiceName}" FontSize="11"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Stepper ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,10">
            <views:StepperControl/>
        </Border>

        <!-- ══ Content ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <views:HomeView
                Visibility="{Binding IsStepHome, Converter={StaticResource BoolToVisibility}}"/>
            <views:FileSelectionView
                Visibility="{Binding IsStepFileSelection, Converter={StaticResource BoolToVisibility}}"/>
            <views:OptionsView
                Visibility="{Binding IsStepOptions, Converter={StaticResource BoolToVisibility}}"/>
            <views:ConvertingView
                Visibility="{Binding IsStepConverting, Converter={StaticResource BoolToVisibility}}"/>
            <views:ResultsView
                Visibility="{Binding IsStepResults, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Busy overlay (analyse) -->
            <Grid Background="#AA000000"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding BusyMessage}" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <ProgressBar Width="300" Height="8"
                                 Value="{Binding ProgressValue}" Maximum="100"
                                 Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0}%'}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center" FontSize="12" Margin="0,8,0,16"/>
                    <Button Content="Annuler" Style="{StaticResource ButtonDanger}"
                            Command="{Binding CancelConversionCommand}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══ Log panel ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <views:LogPanelView x:Name="LogPanel"/>
        </Border>

        <!-- ══ Status bar ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{StaticResource BrushSWBlue}" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding BusyMessage, FallbackValue='Prêt'}"
                           Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding FileCountDisplay}"
                           Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
