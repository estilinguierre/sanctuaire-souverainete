<UserControl x:Class="ParasolidConverterPro.Views.ConvertingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BrushBg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">

            <TextBlock Text="Conversion en cours…" Style="{StaticResource TextTitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding BatchStatus, FallbackValue='Initialisation…'}"
                       Style="{StaticResource TextSubtitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,32"/>

            <!-- Progress ring (simulated with border + percentage) -->
            <Border Width="88" Height="88" CornerRadius="44"
                    BorderBrush="{StaticResource BrushAccent}" BorderThickness="5"
                    HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="{Binding BatchProgress, StringFormat='{}{0}%'}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Batch progress bar -->
            <ProgressBar Value="{Binding BatchProgress}" Maximum="100"
                         Height="8" Margin="0,0,0,10">
                <ProgressBar.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF005FAD" Offset="0"/>
                        <GradientStop Color="#FF0078D4" Offset="1"/>
                    </LinearGradientBrush>
                </ProgressBar.Foreground>
            </ProgressBar>

            <!-- Batch label -->
            <TextBlock Text="{Binding BatchStatus, FallbackValue=''}"
                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- Per-file progress card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="FICHIER EN COURS" Style="{StaticResource TextLabel}"/>
                    <TextBlock Text="{Binding BatchStatus, FallbackValue='—'}"
                               FontFamily="Consolas, Courier New" FontSize="12"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,4"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100"
                                 Margin="0,8,0,0" Height="4"
                                 Foreground="{StaticResource BrushSWOrange}"/>
                    <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0}%'}"
                               FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Right" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="Annuler la conversion"
                    Style="{StaticResource ButtonDanger}"
                    Command="{Binding CancelConversionCommand}"
                    HorizontalAlignment="Center" Padding="24,10"/>

            <TextBlock Text="SolidWorks reste disponible pendant la conversion batch."
                       FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
