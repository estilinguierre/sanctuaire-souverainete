<UserControl x:Class="ParasolidConverterPro.Views.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ParasolidConverterPro.Models"
             xmlns:conv="clr-namespace:ParasolidConverterPro.Converters">

    <UserControl.Resources>
        <conv:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Log toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface2}"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Grid.Column="0" Text="JOURNAL D'EXÉCUTION"
                           FontSize="10" FontWeight="Bold" LetterSpacing="1"
                           Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center"/>

                <!-- Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Filtre :" FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox FontSize="11" SelectedIndex="0" MinWidth="80"
                              ItemsSource="{x:Static models:LogLevelItems.All}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Copier" Style="{StaticResource ButtonSecondary}"
                            Padding="8,4" FontSize="11" Margin="0,0,4,0"
                            Command="{Binding CopyCommand}"/>
                    <Button Content="Exporter" Style="{StaticResource ButtonSecondary}"
                            Padding="8,4" FontSize="11" Margin="0,0,4,0"
                            Command="{Binding ExportCommand}"/>
                    <Button Content="Vider" Style="{StaticResource ButtonDanger}"
                            Padding="8,4" FontSize="11"
                            Command="{Binding ClearCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log entries -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Entries}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 x:Name="LogListBox">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LogEntry}">
                    <Grid Margin="12,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TimestampDisplay}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="Consolas, Courier New" FontSize="11"
                                   VerticalAlignment="Center"/>

                        <!-- Level -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LevelDisplay}"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                   FontFamily="Consolas, Courier New" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <!-- Source -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Source, StringFormat='[{0}]'}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="Consolas, Courier New" FontSize="11"
                                   VerticalAlignment="Center"/>

                        <!-- Message -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Message}"
                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                   FontFamily="Consolas, Courier New" FontSize="11"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
