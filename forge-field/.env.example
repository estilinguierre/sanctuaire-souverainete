# ─── LLM Provider ───────────────────────────────────────────────────────────
# Option A: Anthropic Claude (hosted, default for dev)
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# Option B: OpenAI-compatible endpoint (Ollama + Hermes, LM Studio, vLLM)
# Uncomment to switch to sovereign/local inference
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=hermes-3-llama-3.1-8b

# ─── Supabase (PostgreSQL) ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Whisper STT ─────────────────────────────────────────────────────────────
# Option A: OpenAI hosted Whisper
OPENAI_API_KEY=sk-...

# Option B: Self-hosted (faster-whisper / whisper.cpp)
# WHISPER_BASE_URL=http://localhost:9000
# WHISPER_PROVIDER=local

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_TTL_SECONDS=3600
