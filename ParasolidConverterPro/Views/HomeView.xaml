<UserControl x:Class="ParasolidConverterPro.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BrushBg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="600">

            <!-- Hero icon -->
            <Border Width="80" Height="80" CornerRadius="16"
                    Background="{StaticResource BrushSWBlue}"
                    HorizontalAlignment="Center" Margin="0,0,0,24">
                <Grid>
                    <!-- Stylized "P→SW" icon -->
                    <TextBlock Text="▶" FontSize="32" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock Text="Parasolid Converter Pro" FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <TextBlock Text="Convertissez vos fichiers Parasolid (.x_t / .x_b) en pièces&#x0a;et assemblages SolidWorks (.sldprt / .sldasm) automatiquement."
                       FontSize="14" Foreground="{StaticResource BrushTextSecondary}"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Feature cards -->
            <UniformGrid Columns="3" Margin="0,0,0,40">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="📂" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Import" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text=".x_t · .x_b · Dossiers · Glisser-déposer"
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="⚙️" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Conversion" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text=".sldprt · .sldasm · Batch · Assemblages"
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Rapport" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Logs · Markdown · JSON · Traçabilité"
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- CTA button -->
            <Button Content="Commencer →" Style="{StaticResource ButtonPrimary}"
                    Command="{Binding GoToFileSelectionCommand}"
                    FontSize="15" Padding="40,14"
                    HorizontalAlignment="Center"/>

            <TextBlock Text="Glissez des fichiers n'importe où pour commencer rapidement"
                       FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
