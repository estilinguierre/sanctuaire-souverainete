<UserControl x:Class="ParasolidConverterPro.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ParasolidConverterPro.Models">

    <Grid Background="{StaticResource BrushBg}" Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Résultats de la conversion" Style="{StaticResource TextTitle}"/>
            <TextBlock Text="{Binding LastSummary.CompletedAt,
                StringFormat='Terminé le {0:dd/MM/yyyy à HH:mm:ss}', FallbackValue=''}"
                       Style="{StaticResource TextSubtitle}"/>
        </StackPanel>

        <!-- KPI cards -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LastSummary.TotalFiles, FallbackValue='0'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Total" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LastSummary.Succeeded, FallbackValue='0'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushSuccess}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Succès" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LastSummary.PartialSuccess, FallbackValue='0'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushWarning}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Partiel" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="2,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LastSummary.Failed, FallbackValue='0'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushError}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Échecs" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LastSummary.SuccessRate, StringFormat='{}{0:F0}%', FallbackValue='—'}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource BrushAccent}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LastSummary.TotalDurationSeconds,
                        StringFormat='{}{0:F1}s', FallbackValue='—'}"
                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Results DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Results}"
                      AutoGenerateColumns="False"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#0A0078D4"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrushBorder}"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column"
                      RowHeight="36">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BrushSurface2}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Status -->
                    <DataGridTemplateColumn Header="Statut" Width="90" SortMemberPath="StatusDisplay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Background>
                                        <SolidColorBrush Opacity="0.15"
                                            Color="{Binding Status, Converter={StaticResource ConversionStatusToColor}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="{Binding Status, Converter={StaticResource ConversionStatusToColor}}"
                                               FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Fichier source" Width="*"
                                        Binding="{Binding SourceFile.FileName}"/>
                    <DataGridTextColumn Header="Sortie" Width="*"
                                        Binding="{Binding OutputFileName}"/>
                    <DataGridTextColumn Header="Format" Width="80"
                                        Binding="{Binding OutputFormat}"/>
                    <DataGridTextColumn Header="Corps" Width="60"
                                        Binding="{Binding BodiesConverted}"/>
                    <DataGridTextColumn Header="Durée" Width="70"
                                        Binding="{Binding DurationSeconds, StringFormat='{}{0:F2}s'}"/>

                    <!-- Warnings count -->
                    <DataGridTemplateColumn Header="Avert." Width="70" SortMemberPath="Warnings.Count">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Warnings.Count}"
                                           Foreground="{StaticResource BrushWarning}"
                                           FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Warnings.Count,
                                               Converter={StaticResource IntToVisibility}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Exporter le rapport (.md)" Style="{StaticResource ButtonPrimary}"
                    Command="{Binding ExportReportCommand}" Margin="0,0,10,0"/>
            <Button Content="Ouvrir le dossier de sortie" Style="{StaticResource ButtonSecondary}"
                    Command="{Binding OpenOutputFolderCommand}" Margin="0,0,10,0"/>
            <Button Content="Nouvelle session" Style="{StaticResource ButtonSecondary}"
                    Command="{Binding NewSessionCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
